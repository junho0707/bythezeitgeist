# Copy to zeitgeist/.env (gitignored) and fill in.
OPENAI_API_KEY=
# Wikimedia asks for a real contact address in the User-Agent.
WIKI_CONTACT_EMAIL=
# Optional: a different model for summaries.
# SUMMARY_MODEL=gpt-5.4-nano
# LLM backend: "openai" (needs OPENAI_API_KEY) or "opencode" (the default; uses
# the local OpenCode login). LLM_MODEL picks the OpenCode model.
# LLM_PROVIDER=openai
# LLM_MODEL=opencode-go/kimi-k2.7-code
# Optional: stock photos for the video pipeline.
# PEXELS_API_KEY=
